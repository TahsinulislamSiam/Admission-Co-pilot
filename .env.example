# Copy to .env and adjust. By default the app runs against MSW mock API in dev.
# Base URL of the real API when it exists. UI code always calls services, never URLs.
VITE_API_BASE_URL=/api
# Set to "true" to keep MSW mocks in preview/production builds; "false" to disable
VITE_ENABLE_MOCKS=false

# --- AI assistant (server only; never prefix with VITE_) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (free tier; used first if set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash
