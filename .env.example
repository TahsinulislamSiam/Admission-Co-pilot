# Copy to .env and adjust. By default the app runs against the MSW mock API in dev.
# Base URL of the real API when it exists. UI code always calls services, never URLs.
VITE_API_BASE_URL=/api
# Set to "true" to keep MSW mocks in preview/production builds; "false" to disable
VITE_ENABLE_MOCKS=false

# --- AI assistant ---
# "mock" = use the built-in curated knowledge base (default, no key needed)
# "live" = send chats to the local proxy in server/, which calls Google Gemini
VITE_ASSISTANT_MODE=mock

# Server-side only. NEVER prefix these with VITE_ — that would expose them in
# the browser bundle. Read by server/index.js.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated; tried in order. Lite model answers in ~3s.
GEMINI_MODEL=gemini-flash-lite-latest
ASSISTANT_PORT=8787
ASSISTANT_RATE_LIMIT=20
ALLOWED_ORIGINS=http://localhost:5173

# --- Neon Postgres (server-side only) ---
# Neon dashboard > Connect > copy the pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# true = auth + universities served by the Express + Neon API instead of MSW mocks
VITE_USE_DB=false
