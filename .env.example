# Copy to .env and adjust. By default the app runs against the MSW mock API in dev.
# Base URL of the real API when it exists. UI code always calls services, never URLs.
VITE_API_BASE_URL=/api
# Set to "true" to keep MSW mocks in preview/production builds; "false" to disable
VITE_ENABLE_MOCKS=false

# ---------------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------------
# "mock" = use the built-in curated knowledge base (default, no key needed)
# "live" = send chats to the local proxy in server/, which calls OpenAI
VITE_ASSISTANT_MODE=mock

# Server-side only. NEVER prefix these with VITE_ — that would expose them in
# the browser bundle. Read by server/index.js.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_PORT=8787
ASSISTANT_RATE_LIMIT=20
ALLOWED_ORIGINS=http://localhost:5173
